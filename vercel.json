{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!cookies\\.html|privacidad\\.html|google.*\\.html|favicon\\.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
